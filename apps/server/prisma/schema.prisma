generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoryType {
  PRODUCT
  SERVICE
}

enum ListingStatus {
  PENDING
  ACTIVE
  PAUSED
  SOLD
  REJECTED
}

enum ContactEventType {
  TELEGRAM_CLICK
  PHONE_CLICK
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum BoostDuration {
  DAYS_3
  DAYS_7
  DAYS_30
}

enum PlanTier {
  STANDARD
  BUSINESS
}

enum PaymentStatus {
  CREATED
  WAITING
  PAID
  CANCELLED
}

enum NotificationType {
  LISTING_APPROVED
  LISTING_REJECTED
  BOOST_PAID
  PLAN_PAID
  NEW_MESSAGE
  REPORT_RESOLVED
  LISTING_EXPIRED
}

enum RequestStatus {
  ACTIVE
  CLOSED
}

model User {
  id         String   @id @default(cuid())
  telegramId String   @unique
  username   String?
  firstName  String
  phone      String?
  lat        Float?
  lng        Float?
  isAdmin       Boolean  @default(false)
  isBlocked     Boolean  @default(false)
  listingsLimit Int      @default(1)
  createdAt     DateTime @default(now())

  listings         Listing[]
  favorites        Favorite[]
  messagesSent     Message[]    @relation("MessagesSent")
  messagesReceived Message[]    @relation("MessagesReceived")
  reports          Report[]
  ratingsGiven     Rating[]     @relation("RatingsGiven")
  ratingsReceived  Rating[]     @relation("RatingsReceived")
  boostOrders      BoostOrder[]
  planOrders       PlanOrder[]
  notifications    Notification[]
  requests         Request[]
}

model Category {
  id       String       @id @default(cuid())
  parentId String?
  parent   Category?    @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[]   @relation("CategoryTree")
  nameUz   String
  type     CategoryType
  icon     String?
  sortOrder Int         @default(0)

  listings Listing[]
  requests Request[]
}

model Listing {
  id           String        @id @default(cuid())
  sellerId     String
  seller       User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id])
  title        String
  description  String
  price        Float?
  isNegotiable Boolean       @default(false)
  photos       String[]
  addressText  String?
  regionId     Int?
  districtId   Int?
  lat          Float?
  lng          Float?
  phone        String
  status       ListingStatus @default(PENDING)
  rejectionReason String?
  viewsCount   Int           @default(0)
  boostedUntil DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  contactEvents ContactEvent[]
  favorites     Favorite[]
  messages      Message[]
  reports       Report[]
  ratings       Rating[]
  boostOrders   BoostOrder[]
  views         ListingView[]

  @@index([categoryId, status])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model ContactEvent {
  id         String           @id @default(cuid())
  listingId  String
  listing    Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  fromUserId String
  type       ContactEventType
  createdAt  DateTime         @default(now())
}

model Message {
  id                String   @id @default(cuid())
  listingId         String
  listing           Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  fromUserId        String
  fromUser          User     @relation("MessagesSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId          String
  toUser            User     @relation("MessagesReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  text              String
  telegramMessageId Int?
  createdAt         DateTime @default(now())

  @@index([telegramMessageId])
}

model Report {
  id         String       @id @default(cuid())
  listingId  String
  listing    Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
}

model Rating {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  raterId   String
  rater     User     @relation("RatingsGiven", fields: [raterId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User     @relation("RatingsReceived", fields: [sellerId], references: [id], onDelete: Cascade)
  stars     Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([listingId, raterId])
}

model BoostOrder {
  id           String        @id @default(cuid())
  listingId    String
  listing      Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  duration     BoostDuration
  amount       Int
  status       PaymentStatus @default(CREATED)
  clickTransId String?
  createdAt    DateTime      @default(now())
  paidAt       DateTime?
}

model PlanOrder {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier         PlanTier
  amount       Int
  listingsLimit Int
  status       PaymentStatus @default(CREATED)
  clickTransId String?
  createdAt    DateTime      @default(now())
  paidAt       DateTime?
}

model ListingView {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  viewerId  String
  createdAt DateTime @default(now())

  @@unique([listingId, viewerId])
}

model PricingConfig {
  id           String   @id @default(cuid())
  boostDays3   Int      @default(10000)
  boostDays7   Int      @default(20000)
  boostDays30  Int      @default(50000)
  planStandard Int      @default(25000)
  planBusiness Int      @default(60000)
  updatedAt    DateTime @updatedAt
}

model Banner {
  id        String   @id @default(cuid())
  imageUrl  String
  linkUrl   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

model Request {
  id          String        @id @default(cuid())
  authorId    String
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  title       String
  description String
  budgetMin   Float?
  budgetMax   Float?
  addressText String?
  regionId    Int?
  districtId  Int?
  phone       String
  status      RequestStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId, status])
}

model BotSettings {
  id        String   @id @default(cuid())
  channelId String?
  updatedAt DateTime @updatedAt
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoryType {
  PRODUCT
  SERVICE
}

enum SellerType {
  PRIVATE
  BUSINESS
}

enum ListingStatus {
  PENDING
  ACTIVE
  PAUSED
  SOLD
  REJECTED
}

enum ContactEventType {
  TELEGRAM_CLICK
  PHONE_CLICK
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum BoostDuration {
  DAYS_3
  DAYS_7
  DAYS_30
}

enum PlanTier {
  STANDARD
  BUSINESS
}

enum PaymentStatus {
  CREATED
  WAITING
  PAID
  CANCELLED
}

enum NotificationType {
  LISTING_APPROVED
  LISTING_REJECTED
  BOOST_PAID
  PLAN_PAID
  NEW_MESSAGE
  REPORT_RESOLVED
  LISTING_EXPIRED
  SAVED_SEARCH_MATCH
  REFERRAL_BONUS
  WALLET_TOPUP
  NEW_RATING
  PRICE_DROP
  PRICE_OFFER_RECEIVED
  PRICE_OFFER_RESOLVED
}

enum RequestStatus {
  ACTIVE
  CLOSED
}

enum ListingCondition {
  NEW
  USED
}

enum TopupMethod {
  CLICK
  STARS
}

enum WalletTransactionType {
  TOPUP_CLICK
  TOPUP_STARS
  REFERRAL_BONUS
  BOOST_PURCHASE
  PLAN_PURCHASE
}

model User {
  id            String   @id @default(cuid())
  telegramId    String   @unique
  username      String?
  firstName     String
  phone         String?
  lat           Float?
  lng           Float?
  regionId      Int?
  districtId    Int?
  isAdmin       Boolean  @default(false)
  isBlocked     Boolean  @default(false)
  listingsLimit Int      @default(1)
  balance       Int      @default(0)
  referredById  String?
  referredBy    User?    @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals     User[]   @relation("Referrals")
  createdAt     DateTime @default(now())

  listings           Listing[]
  favorites          Favorite[]
  messagesSent       Message[]           @relation("MessagesSent")
  messagesReceived   Message[]           @relation("MessagesReceived")
  reports            Report[]
  ratingsGiven       Rating[]            @relation("RatingsGiven")
  ratingsReceived    Rating[]            @relation("RatingsReceived")
  boostOrders        BoostOrder[]
  planOrders         PlanOrder[]
  notifications      Notification[]
  requests           Request[]
  blocksMade         UserBlock[]         @relation("BlocksMade")
  blocksReceived     UserBlock[]         @relation("BlocksReceived")
  savedSearches      SavedSearch[]
  walletTransactions WalletTransaction[]
  walletTopupOrders  WalletTopupOrder[]
  priceOffers        PriceOffer[]
}

model Category {
  id        String       @id
  parentId  String?
  parent    Category?    @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]   @relation("CategoryTree")
  nameUz    String
  nameRu    String?
  type      CategoryType
  icon      String?
  level     Int          @default(1)
  sortOrder Int          @default(0)

  listings Listing[]
  requests Request[]
}

model Listing {
  id              String            @id @default(cuid())
  sellerId        String
  seller          User              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category          @relation(fields: [categoryId], references: [id])
  title           String
  description     String
  brand           String?
  attributes      Json?
  price           Float?
  previousPrice   Float?
  priceUsd        Float?
  isNegotiable    Boolean           @default(false)
  isFree          Boolean           @default(false)
  isUrgent        Boolean           @default(false)
  hasDelivery     Boolean           @default(false)
  sellerType      SellerType?
  contactTelegram Boolean           @default(true)
  photos          String[]
  addressText     String?
  regionId        Int?
  districtId      Int?
  lat             Float?
  lng             Float?
  phone           String
  contactName     String?
  condition       ListingCondition?
  status          ListingStatus     @default(PENDING)
  rejectionReason String?
  viewsCount      Int               @default(0)
  boostedUntil    DateTime?
  bumpedAt        DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  contactEvents ContactEvent[]
  favorites     Favorite[]
  messages      Message[]
  reports       Report[]
  ratings       Rating[]
  boostOrders   BoostOrder[]
  views         ListingView[]
  priceHistory  PriceHistory[]
  priceOffers   PriceOffer[]

  @@index([categoryId, status])
}

enum PriceOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model PriceOffer {
  id        String           @id @default(cuid())
  listingId String
  listing   Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User             @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  amount    Float
  status    PriceOfferStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([listingId])
  @@index([buyerId])
}

model PriceHistory {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  price     Float?
  createdAt DateTime @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model ContactEvent {
  id         String           @id @default(cuid())
  listingId  String
  listing    Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  fromUserId String
  type       ContactEventType
  createdAt  DateTime         @default(now())
}

model Message {
  id                String   @id @default(cuid())
  listingId         String
  listing           Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  fromUserId        String
  fromUser          User     @relation("MessagesSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId          String
  toUser            User     @relation("MessagesReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  text              String
  telegramMessageId Int?
  createdAt         DateTime @default(now())

  @@index([telegramMessageId])
}

model Report {
  id         String       @id @default(cuid())
  listingId  String
  listing    Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
}

model Rating {
  id              String    @id @default(cuid())
  listingId       String
  listing         Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  raterId         String
  rater           User      @relation("RatingsGiven", fields: [raterId], references: [id], onDelete: Cascade)
  sellerId        String
  seller          User      @relation("RatingsReceived", fields: [sellerId], references: [id], onDelete: Cascade)
  stars           Int
  comment         String?
  isAnonymous     Boolean   @default(false)
  sellerReply     String?
  sellerRepliedAt DateTime?
  createdAt       DateTime  @default(now())

  @@unique([listingId, raterId])
}

model BoostOrder {
  id           String        @id @default(cuid())
  listingId    String
  listing      Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  duration     BoostDuration
  amount       Int
  status       PaymentStatus @default(CREATED)
  clickTransId String?
  createdAt    DateTime      @default(now())
  paidAt       DateTime?
}

model PlanOrder {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier          PlanTier
  amount        Int
  listingsLimit Int
  status        PaymentStatus @default(CREATED)
  clickTransId  String?
  createdAt     DateTime      @default(now())
  paidAt        DateTime?
}

model ListingView {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  viewerId  String
  createdAt DateTime @default(now())

  @@unique([listingId, viewerId])
}

model PricingConfig {
  id           String   @id @default(cuid())
  boostDays3   Int      @default(10000)
  boostDays7   Int      @default(20000)
  boostDays30  Int      @default(50000)
  planStandard Int      @default(25000)
  planBusiness Int      @default(60000)
  updatedAt    DateTime @updatedAt
}

model Banner {
  id        String   @id @default(cuid())
  imageUrl  String
  linkUrl   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

model Request {
  id          String        @id @default(cuid())
  authorId    String
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  title       String
  description String
  budgetMin   Float?
  budgetMax   Float?
  addressText String?
  regionId    Int?
  districtId  Int?
  phone       String
  status      RequestStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId, status])
}

model BotSettings {
  id                 String   @id @default(cuid())
  channelId          String?
  starsRate          Int      @default(200)
  usdRate            Int      @default(12700)
  telegramChannelUrl String?
  supportUrl         String?
  anthropicApiKey    String?
  updatedAt          DateTime @updatedAt
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model SavedSearch {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  categoryId String?
  regionId   Int?
  districtId Int?
  minPrice   Int?
  maxPrice   Int?
  condition  ListingCondition?
  q          String?
  createdAt  DateTime          @default(now())
}

model WalletTransaction {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  type      WalletTransactionType
  note      String?
  createdAt DateTime              @default(now())
}

model WalletTopupOrder {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int
  method       TopupMethod
  starsAmount  Int?
  status       PaymentStatus @default(CREATED)
  clickTransId String?
  createdAt    DateTime      @default(now())
  paidAt       DateTime?
}
